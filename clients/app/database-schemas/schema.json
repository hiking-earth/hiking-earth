        [
          "reporter",
          "String",
          "举报人"
        ],
        [
          "postId",
          "String",
          "帖子"
        ],
        [
          "reason",
          "String",
          "原因"
        ],
        [
          "createdAt",
          "Number",
          "时间"
        ],
        [
          "status",
          "String",
          "pending/resolved"
        ]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "client_account_merges",
      "description": "统一账号身份合并任务（包含受保护的续跑凭据摘要与迁移状态，仅可信云函数访问）",
      "schema": [
        ["status", "String", "running/complete"],
        ["targetAccountId", "String", "目标账号文档 ID"],
        ["target", "Object", "目标账号身份快照"],
        ["sources", "Array", "来源账号及历史身份别名快照"],
        ["phone", "Object", "经 HMAC 处理的已授权手机号标识"],
        ["phoneHash", "String", "续跑任务手机号检索键（HMAC）"],
        ["wechat", "Object", "微信 AppID/OpenID/UnionID 身份快照"],
        ["secretHash", "String", "续跑令牌 SHA-256 摘要"],
        ["phaseIndex", "Number", "当前迁移阶段"],
        ["sourceIndex", "Number", "当前身份迁移游标"],
        ["migrated", "Number", "已处理记录数"],
        ["sessionExpiresAt", "Number", "短期续跑会话过期时间"],
        ["createdAt", "Number", "创建时间戳"],
        ["updatedAt", "Number", "更新时间戳"],
        ["completedAt", "Number", "完成时间戳"],
        ["sourceIdentities", "Array", "合并完成后返回客户端的来源身份" ]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "client_account_merge_library_archives",
      "description": "账号合并时因容量超限而保留的来源收藏/行程，仅可信云函数可列出与恢复",
      "schema": [
        ["targetAccountId", "String", "目标账号文档 ID"],
        ["sourceIdentity", "String", "来源身份"],
        ["favorites", "Array", "来源收藏原样备份"],
        ["plans", "Array", "来源行程原样备份"],
        ["sourceVersion", "Number", "来源资料版本"],
        ["sourceUpdatedAt", "Number", "来源更新时间"],
        ["createdAt", "Number", "归档时间"]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "route_access_audit_snapshots",
      "description": "公开路线目录限制信号的定时筛查快照，仅供可信云函数和授权审核员读取；不代表路线关闭或授予通行权",
      "schema": [
        ["schemaVersion", "Number", "快照格式版本"],
        ["snapshot", "String", "规范化快照 SHA-256"],
        ["generatedAt", "String", "源目录扫描时间"],
        ["publishedAt", "Number", "云端接收时间"],
        ["candidateCount", "Number", "全部风险候选数量"],
        ["listedCount", "Number", "快照内候选数量，上限2000"],
        ["truncated", "Boolean", "候选是否超过存储上限"],
        ["sourceCount", "Number", "已扫描来源数"],
        ["bytes", "Number", "序列化快照字节数"],
        ["items", "Array", "人工复核候选，不包含开放或导航授权"]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    }
  ]
}
