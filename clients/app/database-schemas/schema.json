        ],
        [
          "openid",
          "String",
          "队员 openid"
        ],
        [
          "nickname",
          "String",
          "昵称"
        ],
        [
          "latitude",
          "Number",
          "纬度"
        ],
        [
          "longitude",
          "Number",
          "经度"
        ],
        [
          "updatedAt",
          "Number",
          "更新时间戳"
        ],
        [
          "isLeader",
          "Boolean",
          "是否队长"
        ]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "sos_events",
