        [
          "owner",
          "String",
          "归属 openid"
        ],
        [
          "trackId",
          "String",
          "本地轨迹 id"
        ],
        [
          "name",
          "String",
          "轨迹名"
        ],
        [
          "routeId",
          "String",
          "关联路线"
        ],
        [
          "points",
          "Array",
