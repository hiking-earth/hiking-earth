        [
          "openid",
          "String",
          "发布人 openid"
        ],
        [
          "nickname",
          "String",
          "昵称"
        ],
        [
          "routeId",
          "String",
          "关联路线 id"
        ],
        [
          "title",
          "String",
          "标题"
        ],
        [
          "content",
          "String",
          "内容"
        ],
        [
          "departDate",
          "String",
          "出发日期"
        ],
        [
          "maxMembers",
          "Number",
          "人数上限"
        ],
        [
          "members",
          "Array",
          "已报名 openid"
        ],
        [
          "createdAt",
          "Number",
          "创建时间戳"
        ],
        [
          "status",
          "String",
          "open/full/closed"
        ]
      ],
      "rule": {
        "read": false,
        "write": false
      }
    },
    {
