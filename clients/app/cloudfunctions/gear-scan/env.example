# Server-side CloudBase environment only. Never copy keys into VITE_* variables.
# The same random 64-character hexadecimal token is required on client-api.
GEAR_SCAN_INTERNAL_TOKEN=
GEAR_SCAN_BACKEND=cpu

# Optional Qwen mode: first enable Free Quota Only for the selected model in
# Model Studio. These booleans cannot change the provider's billing settings.
# Copy the Beijing workspace compatible-mode base URL from its official console.
GEAR_QWEN_BASE_URL=
GEAR_QWEN_API_KEY=
GEAR_QWEN_MODEL=qwen3-vl-plus
GEAR_QWEN_FREE_TIER_ONLY=false
GEAR_QWEN_STOP_ON_FREE_QUOTA=false

# DeepSeek is billable. It remains disabled in the free-first configuration.
GEAR_DEEPSEEK_ALLOW_PAID=false
GEAR_DEEPSEEK_API_KEY=
GEAR_DEEPSEEK_BASE_URL=https://api.deepseek.com
GEAR_DEEPSEEK_MODEL=deepseek-flash
